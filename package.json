{
  "name": "alliance-mutual-escrow",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Production website for Alliance Mutual Escrow, an independent DFPI licensed escrow company serving California.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "sync": "node scripts/sync-roster.mjs",
    "prebuild": "node scripts/sync-roster.mjs && node scripts/build-guide-pdfs.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node tests/regression.mjs",
    "test:build": "npm run build && node tests/regression.mjs",
    "deploy": "npm run build && node tests/regression.mjs && wrangler pages deploy dist --project-name alliance-mutual-escrow",
    "deploy:preview": "npm run build && wrangler pages deploy dist --project-name alliance-mutual-escrow --branch preview"
  },
  "dependencies": {
    "@astrojs/react": "^4.2.0",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^5.4.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.1.1",
    "@fontsource/instrument-serif": "^5.1.1",
    "@fontsource/inter": "^5.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "playwright": "^1.50.0",
    "wrangler": "^3.100.0"
  }
}
