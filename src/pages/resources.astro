import LegalPage from '../components/LegalPage.astro';
---

<LegalPage
  title="Resources · Alliance Mutual Escrow"
  description="Official California and federal resources for escrow consumers: the DFPI, the DRE, the CFPB, and wire fraud reporting."
  kicker="Official links"
  heading="Resources"
>
  <h2>Regulators and official bodies</h2>
  <p>
    <b>DFPI</b>, the California Department of Financial Protection and Innovation, licenses and
    audits independent escrow companies like ours. Verify a license or file a complaint at
    <a href="https://dfpi.ca.gov" rel="noopener" style="color:var(--amber)">dfpi.ca.gov</a>.
  </p>
  <p>
    <b>DRE</b>, the California Department of Real Estate, licenses real estate agents and brokers:
    <a href="https://dre.ca.gov" rel="noopener" style="color:var(--amber)">dre.ca.gov</a>.
  </p>
  <p>
    <b>CFPB</b>, the federal Consumer Financial Protection Bureau, publishes plain-English guides to
    mortgages and closing documents:
    <a href="https://consumerfinance.gov" rel="noopener" style="color:var(--amber)">consumerfinance.gov</a>.
  </p>

  <h2>If you suspect wire fraud</h2>
  <p>
    Call your bank first and ask for a wire recall, then report it to the FBI's Internet Crime
    Complaint Center at <a href="https://ic3.gov" rel="noopener" style="color:var(--amber)">ic3.gov</a>.
    Then call us: (714) 544-6525. Our
    <a href="/guides/wire-fraud-safety" style="color:var(--amber)">wire fraud safety guide</a>
    explains how to avoid it in the first place.
  </p>

  <h2>Our library</h2>
  <p>
    Our own <a href="/guides" style="color:var(--amber)">escrow guides</a> cover the basics, the 30
    day timeline, buyer and seller playbooks, and specialty files, each downloadable as a PDF.
  </p>
</LegalPage>
