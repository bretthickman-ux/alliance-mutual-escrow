---
import BaseLayout from '../layouts/BaseLayout.astro';
import HBand from '../components/HBand.astro';
import investorsImg from '../assets/doors/investors.jpg';
import '../styles/interior.css';

const faq = [
  {
    q: 'Can you work with my exchange accommodator?',
    a: 'Yes. We coordinate directly with your qualified intermediary and build the escrow timeline around the exchange deadlines.',
  },
  {
    q: 'Do specialty files cost more?',
    a: 'Only the published add-ons: $250 for 1031 processing, standard sale or refinance fees otherwise. Complex does not mean opaque.',
  },
];
---

<BaseLayout
  title="For Investors & Specialty Files · Alliance Mutual Escrow"
  description="1031 exchanges, bulk sales, probate, and commercial refinance, handled as regular work by officers who do them routinely."
  bodyClass="page-interior"
  navVariant="solid"
  navMax={1080}
  faq={faq}
>
  <header class="hero">
    <div class="kick">For investors &amp; specialty files</div>
    <h1>Bring the <i>hard ones.</i></h1>
    <p class="sub">
      Exchanges with deadlines that do not move. Bulk sales with creditor timelines. Probate with a
      court watching. This is the work we like.
    </p>
  </header>

  <HBand image={investorsImg} tag="The horizon, on schedule" />

  <div class="wrap">
    <main>
      <h2>The complicated files are the point</h2>
      <p>
        Routine escrow rewards patience. Specialty escrow rewards precision, and precision is a
        habit here. Our officers handle
        <b>1031 exchanges, bulk sales, probate closings, and commercial refinance</b> as regular
        work, not exceptions.
      </p>

      <div class="nums">
        <div class="nb"><div class="nv" data-n="45">0</div><div class="nl">Days to identify a<br />1031 replacement</div></div>
        <div class="nb"><div class="nv" data-n="180">0</div><div class="nl">Days to close it</div></div>
        <div class="nb rule">
          <div class="nv">Hard law.</div>
          <div class="nl">No extensions, no grace</div>
          <div class="nt">
            We build the escrow calendar backward from these dates, with your accommodator in the
            loop from day one.
          </div>
        </div>
      </div>

      <h2>What we handle</h2>
      <p>
        <b>1031 exchanges.</b> Identification and closing deadlines are hard law. We coordinate with
        your accommodator so the calendar is never the thing that breaks the exchange. Processing is
        a published $250.
      </p>
      <p><b>Bulk sales.</b> Business transfers with notice and creditor claim periods, run by officers who do them routinely.</p>
      <p><b>Probate and court-supervised sales.</b> Confirmation dates, required notices, and documentation the court will accept the first time.</p>
      <p><b>Commercial refinance.</b> $95 base plus $0.95 per $1,000, minimum $500,000, with the same funding discipline our lenders rely on.</p>

      <h2>Frequently asked</h2>
      <div class="faq">
        {faq.map((f) => (
          <div class="fq">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </div>
    </main>

    <aside class="aside">
      <div class="card">
        <div class="ch">Specialty, published</div>
        <div class="fr"><span class="k">1031 processing</span><span class="v">$250</span></div>
        <div class="fr"><span class="k">Subordination agreement</span><span class="v">$50</span></div>
        <div class="fr"><span class="k">Solar transfer, per side</span><span class="v">$100</span></div>
        <div class="fr"><span class="k">Doc prep, each</span><span class="v">$50</span></div>
        <div class="fr tot"><span class="k">Commercial refi</span><span class="v">$95 + $0.95/K</span></div>
        <div class="cn">Sale and refinance base fees apply as published. Nothing bespoke about the pricing, only the handling.</div>
      </div>
    </aside>
  </div>

  <section class="cta">
    <div class="cta-in">
      <h2>Complex file? <i>Good.</i></h2>
      <a class="btn" href="tel:7145446525">Talk to a licensed officer</a>
    </div>
  </section>

  <p class="note">
    Sample page for design review. Copy is draft, written fresh; figures are from the published fee
    schedule. Third-party costs are estimates from providers you choose.
  </p>

  <script>
    import '../scripts/interior-motion';
  </script>
</BaseLayout>
