---
import BaseLayout from '../layouts/BaseLayout.astro';
import EscrowCalculator from '../components/calculator/EscrowCalculator.jsx';
import { fees } from '../data/fees';
import '../styles/interior.css';
import '../styles/calc.css';
---

<BaseLayout
  title="Escrow Fee Calculator · Alliance Mutual Escrow"
  description="Estimate your escrow fees in seconds: buyer, seller, and refinance, itemized from the published schedule. Anonymous, no signup."
  bodyClass="page-interior"
  navVariant="solid"
  navMax={1080}
>
  <header class="calc-hero">
    <div class="kick">Fees, in the open</div>
    <h1 style="max-width:none">What will escrow <i>actually cost?</i></h1>
    <p class="sub" style="margin-left:auto;margin-right:auto">
      Pick your side, enter a number, and see every line before you commit. No signup, no email
      required, nothing stored.
    </p>
  </header>

  <div class="calc-wrap">
    <EscrowCalculator client:load />
  </div>

  <div class="calc-below">
    <div class="sched">
      <div class="card">
        <div class="ch">Sale escrow, each side</div>
        <div class="fr"><span class="k">Base</span><span class="v">$300</span></div>
        <div class="fr"><span class="k">Per $1,000 of the price</span><span class="v">$2.15</span></div>
        <div class="fr"><span class="k">Per $1,000 past $2,000,000</span><span class="v">$1.75</span></div>
        <div class="fr tot" id="sale-example"><span class="k">Example at $1,000,000</span><span class="v">$2,450</span></div>
      </div>
      <div class="card">
        <div class="ch">Refinance, one flat fee by loan size</div>
        <div class="fr" data-tier="750000"><span class="k">Up to $750,000</span><span class="v">$650</span></div>
        <div class="fr" data-tier="1000000"><span class="k">To $1,000,000</span><span class="v">$850</span></div>
        <div class="fr" data-tier="2000000"><span class="k">To $2,000,000</span><span class="v">$1,200</span></div>
        <div class="fr" data-tier="max"><span class="k">Over $2,000,000</span><span class="v">QUOTE</span></div>
        <div class="fr tot"><span class="k">Processing</span><span class="v">$200</span></div>
      </div>
      <div class="card">
        <div class="ch">Add-ons, published</div>
        <div class="fr"><span class="k">1031 processing</span><span class="v">$250</span></div>
        <div class="fr"><span class="k">HELOC or second-only escrow</span><span class="v">$250</span></div>
        <div class="fr"><span class="k">Solar transfer, per side</span><span class="v">$100</span></div>
        <div class="fr"><span class="k">Subordination · doc prep · grant deed · tax form · archive · HOA</span><span class="v">$50</span></div>
        <div class="fr"><span class="k">Demand processing, per payoff</span><span class="v">$30</span></div>
        <div class="fr"><span class="k">Payoff of bills, each</span><span class="v">$10</span></div>
      </div>
      <div class="card">
        <div class="ch">Multi-family &amp; commercial refinance</div>
        <div class="fr"><span class="k">Base</span><span class="v">$95</span></div>
        <div class="fr"><span class="k">Per $1,000 of the loan</span><span class="v">$0.95</span></div>
        <div class="fr tot"><span class="k">Loan minimum</span><span class="v">$500,000</span></div>
        <div class="cn">
          Title insurance, recording, and transfer taxes come from third parties and your county;
          your escrow officer itemizes them on your file.
        </div>
      </div>
    </div>
  </div>

  <section class="cta">
    <div class="cta-in">
      <h2>Want it exact? <i>Ask an escrow officer.</i></h2>
      <a class="btn" href="tel:7145446525">Call (714) 544-6525</a>
    </div>
  </section>

  <script>
    // Two live touches on the published schedule, driven by the calculator:
    // the sale example row tracks the slider, and the active refi tier
    // highlights. The published rates themselves never move.
    const usd = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
    const example = document.getElementById('sale-example');
    const tiers = Array.from(document.querySelectorAll<HTMLElement>('[data-tier]'));
    window.addEventListener('ame:calc-change', (e) => {
      const { mode, amount, fee } = (e as CustomEvent).detail || {};
      if (example) {
        const k = example.querySelector('.k');
        const v = example.querySelector('.v');
        if (mode !== 'refinance' && amount != null && fee != null && k && v) {
          k.textContent = `At your price, ${usd(amount)}`;
          v.textContent = usd(fee);
        } else if (k && v) {
          k.textContent = 'Example at $1,000,000';
          v.textContent = '$2,450';
        }
      }
      tiers.forEach((row) => {
        let on = false;
        if (mode === 'refinance' && amount != null) {
          const t = row.dataset.tier;
          if (t === 'max') on = amount > 2_000_000;
          else {
            const cap = Number(t);
            const prev = tiers[tiers.indexOf(row) - 1];
            const floor = prev && prev.dataset.tier !== 'max' ? Number(prev.dataset.tier) : 0;
            on = amount <= cap && amount > floor;
          }
        }
        row.classList.toggle('tier-on', on);
      });
    });
  </script>
</BaseLayout>
