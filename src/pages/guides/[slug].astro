---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import { guides } from '../../data/guides.mjs';
import '../../styles/interior.css';

import imgFam from '../../assets/home/fam.jpg';
import imgLake from '../../assets/doors/agents.jpg';
import imgDusk from '../../assets/doors/lenders.jpg';
import imgFoothills from '../../assets/doors/investors.jpg';
import imgPark from '../../assets/home/park.jpg';
// Pexels (free license, commercial use, no attribution): one distinct image
// per guide so no photo repeats across the library.
import imgKeysHandoff from '../../assets/guides/keys-handoff.jpg';
import imgKeysSold from '../../assets/guides/keys-sold-sign.jpg';
import imgSigningCouple from '../../assets/guides/signing-couple.jpg';
import imgSigningCloseup from '../../assets/guides/signing-closeup.jpg';
import imgHouseTwilight from '../../assets/guides/house-twilight.jpg';
import imgCraftsmanPorch from '../../assets/guides/craftsman-porch.jpg';
import imgPorchChairs from '../../assets/guides/porch-chairs.jpg';

export function getStaticPaths() {
  return guides.map((g) => ({ params: { slug: g.slug }, props: { guide: g } }));
}

const { guide } = Astro.props;
const pdfHref = `/pdfs/${guide.slug}.pdf`;

// Guide ecosystem: short labels for the sub-nav strip, plus prev/next.
const SHORT = {
  'what-escrow-does': 'Escrow basics',
  'escrow-timeline': 'The 30 days',
  'wire-fraud-safety': 'Wire safety',
  'buyer-guide': 'Buyers',
  'seller-guide': 'Sellers',
  'refinance-guide': 'Refinance',
  '1031-exchange': '1031 exchange',
  'bulk-sale': 'Bulk sale',
  'probate': 'Probate',
  'mobile-home': 'Mobile home',
  'fsbo': 'FSBO',
  'holding-escrow': 'Holding escrow',
};
const gi = guides.findIndex((g) => g.slug === guide.slug);
const prevGuide = gi > 0 ? guides[gi - 1] : null;
const nextGuide = gi < guides.length - 1 ? guides[gi + 1] : null;

// One warm breather image per guide, matched to its subject. Purely
// atmospheric (alt text stays empty); the words carry the guidance.
const GUIDE_IMAGES = {
  'what-escrow-does': imgCraftsmanPorch,
  'escrow-timeline': imgLake,
  'wire-fraud-safety': imgDusk,
  'buyer-guide': imgSigningCouple,
  'seller-guide': imgFam,
  'refinance-guide': imgHouseTwilight,
  '1031-exchange': imgFoothills,
  'bulk-sale': imgSigningCloseup,
  'probate': imgPorchChairs,
  'mobile-home': imgPark,
  'fsbo': imgKeysSold,
  'holding-escrow': imgKeysHandoff,
};
const breakImg = GUIDE_IMAGES[guide.slug] || imgLake;
---

<BaseLayout
  title={`${guide.title} · Alliance Mutual Escrow`}
  description={guide.description}
  bodyClass="page-interior"
  navVariant="solid"
  navMax={1080}
  faq={guide.faq}
>
  <nav class="g-subnav" aria-label="All guides">
    <div class="g-subnav-in">
      <a class="g-all" href="/guides">All guides</a>
      {guides.map((g) => (
        <a href={`/guides/${g.slug}`} class={g.slug === guide.slug ? 'on' : ''} aria-current={g.slug === guide.slug ? 'page' : undefined}>
          {SHORT[g.slug] || g.title}
        </a>
      ))}
    </div>
  </nav>

  <header class="hero">
    <div class="kick">{guide.kicker}</div>
    <h1>{guide.title}</h1>
    <p class="sub">{guide.lead}</p>
    <p style="margin-top:18px">
      <a
        class="pdfbtn"
        href={pdfHref}
        download
        style="display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:600;padding:11px 20px;border-radius:100px;border:1px solid var(--hair);color:var(--ink);text-decoration:none"
      >
        <svg width="13" height="13" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7 1v8m0 0L4 6m3 3l3-3M2 12h10" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Download as PDF
      </a>
    </p>
  </header>

  <div class="wrap" style="grid-template-columns:1fr;max-width:880px">
    <main class="g-article">
      <aside class="g-glance">
        <div class="g-glance-h">In this guide</div>
        <ol>
          {guide.sections.map((s) => <li>{s.h}</li>)}
          <li>Frequently asked</li>
        </ol>
      </aside>

      {guide.sections.map((s, i) => (
        <>
          <div class="g-sec">
            <span class="g-num">{String(i + 1).padStart(2, '0')}</span>
            <h2>{s.h}</h2>
          </div>
          {s.ps.map((p) => <p>{p}</p>)}
          {i === 0 && (
            <figure class="g-break">
              <Picture src={breakImg} formats={['avif', 'webp']} widths={[640, 960, 1280]} sizes="(max-width: 940px) 92vw, 880px" alt="" />
            </figure>
          )}
        </>
      ))}

      <div class="g-sec">
        <span class="g-num">{String(guide.sections.length + 1).padStart(2, '0')}</span>
        <h2>Frequently asked</h2>
      </div>
      <div class="faq">
        {guide.faq.map((f) => (
          <div class="fq">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </div>
      <nav class="g-pager" aria-label="More guides">
        {prevGuide ? (
          <a class="g-pg prev" href={`/guides/${prevGuide.slug}`}>
            <span class="pl">&larr; Previous guide</span>
            <span class="pt2">{prevGuide.title}</span>
          </a>
        ) : <span />}
        {nextGuide ? (
          <a class="g-pg next" href={`/guides/${nextGuide.slug}`}>
            <span class="pl">Next guide &rarr;</span>
            <span class="pt2">{nextGuide.title}</span>
          </a>
        ) : <span />}
      </nav>

      <p class="note" style="padding-left:0;padding-right:0">
        General information for California consumers, not legal or tax advice. For advice about your
        situation, talk to your attorney or tax professional.
      </p>
    </main>
  </div>

  <section class="cta">
    <div class="cta-in">
      <h2>Questions about your file? <i>Ask an officer.</i></h2>
      <a class="btn" href="tel:7145446525">Call (714) 544-6525</a>
    </div>
  </section>

  <script>
    import '../../scripts/interior-motion';
  </script>
</BaseLayout>
