---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';

import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  navVariant?: 'overlay' | 'solid';
  navPaper?: boolean;
  navMax?: number;
  /** Q&A pairs rendered as FAQPage structured data (Phase 3). */
  faq?: { q: string; a: string }[];
}

const {
  title,
  description = 'Independent, DFPI licensed escrow for California. Named officers, published fees, one licensed officer from open to close.',
  bodyClass = '',
  navVariant = 'solid',
  navPaper = false,
  navMax,
  faq,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

// LocalBusiness structured data on every page, from the section 1 contact facts.
const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'FinancialService',
  name: site.name,
  description:
    'Independent escrow company licensed by the California Department of Financial Protection and Innovation. Residential, refinance, and specialty escrow statewide.',
  url: Astro.site?.href,
  telephone: '+1-714-544-6525',
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.line1,
    addressLocality: site.address.city,
    addressRegion: site.address.state,
    postalCode: site.address.zip,
    addressCountry: 'US',
  },
  areaServed: { '@type': 'State', name: 'California' },
};

const faqSchema = faq && faq.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta name="theme-color" content="#0f1215" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </head>
  <body class={bodyClass} data-brand={site.brand}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav variant={navVariant} paper={navPaper} navMax={navMax} />
    <div id="main">
      <slot />
    </div>
    <Footer />
    <script>
      // Owner review tour: inert unless activated with ?review=1.
      import '../scripts/review-tour';
    </script>
  </body>
</html>
